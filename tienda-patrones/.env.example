# Copia este archivo como .env.local (en tu computadora) o pon las variables en Vercel.

# Dirección pública de la tienda (sin / al final)
NEXT_PUBLIC_SITE_URL=https://tutienda.com

# Secreto para firmar ligas de descarga. OBLIGATORIO en producción.
# Genera uno con:  openssl rand -base64 48
SECRETO_FIRMA=

# Contacto que aparece en el sitio
NEXT_PUBLIC_CORREO_CONTACTO=hola@tutienda.com
NEXT_PUBLIC_WHATSAPP=          # ej. 5216441234567 (vacío = sin botón)
NEXT_PUBLIC_INSTAGRAM=         # usuario sin @

# ── Pagos (configura uno o los dos) ──────────────────────────────────────────
# Mercado Pago → Tus integraciones → Credenciales de producción → Access Token
MP_ACCESS_TOKEN=
# Stripe → Developers → API keys → Secret key
STRIPE_SECRET_KEY=
# Stripe → Developers → Webhooks → (https://tutienda.com/api/webhooks/stripe) → Signing secret
STRIPE_WEBHOOK_SECRET=

# ── Archivos y pedidos (Supabase) ────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=patrones

# ── Correo de entrega (Resend.com, opcional pero recomendado) ────────────────
RESEND_API_KEY=
CORREO_REMITENTE="Trazo <pedidos@tutienda.com>"

# Solo para enseñar la tienda sin pagos reales. NUNCA junto con pagos reales
# (de todos modos se apaga solo si configuras Mercado Pago o Stripe).
MODO_DEMO=
