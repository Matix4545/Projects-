# =====================================================================
# ChambaRadar · Variables de entorno
# Copia este archivo como ".env.local" y llena los valores.
# En Vercel se capturan en Settings → Environment Variables.
# Sin ninguna variable la web funciona en "modo local" leyendo
# data/vacantes.json (genéralo con: npm run recolectar).
# =====================================================================

# --- Sitio ------------------------------------------------------------
# Dominio público, sin "/" al final (enlaces de correo y de Stripe)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Project Settings → API) --------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clave SECRETA service_role. ¡Nunca la compartas ni la subas a GitHub!
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (dashboard.stripe.com → Developers → API keys) -------------
STRIPE_SECRET_KEY=
# Developers → Webhooks → endpoint https://TU-DOMINIO/api/stripe/webhook
# Eventos: checkout.session.completed, checkout.session.async_payment_succeeded
STRIPE_WEBHOOK_SECRET=
# Métodos de pago separados por coma. OXXO hay que activarlo en
# Settings → Payment methods. Si todavía no lo activas, deja solo "card".
STRIPE_METODOS=card,oxxo

# --- Solo para desarrollo ---------------------------------------------
# 1 = ver todas las empresas y enlaces sin pagar (se ignora en producción)
DEMO_ACCESO_TOTAL=
