# =====================================================================
# ChambaRadar · Variables de entorno
# Copia este archivo como ".env.local" y llena los valores.
# En Netlify se capturan en Project configuration → Environment variables.
# Sin ninguna variable la web funciona en "modo local" leyendo
# data/vacantes.json (genéralo con: npm run recolectar).
# =====================================================================

# --- Sitio ------------------------------------------------------------
# Dominio público, sin "/" al final (enlaces del correo de acceso)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Project Settings → API) --------------------------------
# Solo se usan claves PÚBLICAS: el muro de pago vive en la base de datos.
NEXT_PUBLIC_SUPABASE_URL=
# Clave publicable (sb_publishable_…) o la "anon" de siempre
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Clave de la app (SECRETA) -----------------------------------------
# La usan el recolector y el webhook de pagos para escribir en la base.
# Se genera sola al correr supabase/01_esquema.sql. Para verla, en SQL Editor:
#   select valor from config_privada where nombre = 'clave_app';
CHAMBARADAR_CLAVE=

# --- Pagos con Stripe (opcional; sin esto los planes dicen "Próximamente")
# Enlaces de pago (Payment Links) de $49, $129 y $699 MXN con tarjeta y OXXO
STRIPE_ENLACE_SEMANA=
STRIPE_ENLACE_MES=
STRIPE_ENLACE_ANIO=
# Webhook hacia https://TU-DOMINIO/api/stripe/webhook con los eventos
# checkout.session.completed y checkout.session.async_payment_succeeded
STRIPE_WEBHOOK_SECRET=

# --- Alertas por correo con Resend (opcional; sin esto las alertas se guardan pero no se mandan)
# resend.com → API Keys. El remitente debe ser de un dominio verificado en Resend.
RESEND_API_KEY=
CORREO_REMITENTE=ChambaRadar <alertas@tudominio.com>

# --- Solo para desarrollo ---------------------------------------------
# 1 = ver todas las empresas y enlaces sin pagar en modo local (se ignora en producción)
DEMO_ACCESO_TOTAL=
