# =====================================================================
# Reporta Cajeme · Variables de entorno
# Copia este archivo como ".env.local" (en tu computadora) y llena los
# valores. En Vercel se capturan en Settings → Environment Variables.
# =====================================================================

# --- Supabase (Project Settings → API) --------------------------------
# URL del proyecto, p. ej. https://abcdefghijk.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Clave pública "anon" (puede ir en el navegador: solo permite leer datos agregados)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clave SECRETA "service_role". ¡NUNCA la compartas ni la subas a GitHub!
SUPABASE_SERVICE_ROLE_KEY=

# --- Cloudflare Turnstile (dash.cloudflare.com → Turnstile) ------------
# Para probar en tu computadora puedes usar las claves de prueba de
# Cloudflare que siempre aprueban:
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Secreto para anonimizar ------------------------------------------
# Texto largo y aleatorio. Se usa para convertir la IP y el ID del
# dispositivo en un "hash" irreversible. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Si lo cambias, los límites de 6 h / 10 por día se reinician.
HASH_SECRET=

# --- Opcional ---------------------------------------------------------
# Correo de contacto que aparece en "Acerca de"
NEXT_PUBLIC_CONTACTO=

# Servidor de mosaicos del mapa. Por defecto se usa el de OpenStreetMap,
# que es gratuito pero pide no usarlo para mucho tráfico. Si la app crece,
# usa un proveedor (MapTiler, Stadia, etc.) y pon aquí su URL con {z}/{x}/{y}.
NEXT_PUBLIC_TILES_URL=

# --- Avisos en tu celular cada 100 reportes (opcional) ------------------
# 1) Instala la app "ntfy" (Android / iPhone) y suscríbete a un tema con un
#    nombre difícil de adivinar, p. ej. reportacajeme-k3x9q2.
# 2) Pon aquí ese mismo nombre. Déjalo vacío para no recibir avisos.
NTFY_TOPIC=
# Cada cuántos reportes avisar (por defecto 100)
AVISAR_CADA=100
